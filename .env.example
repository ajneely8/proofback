# Copy this file to `.env` and restart `npm run dev` after editing.

# Required for receipt scanning. Get a key at https://console.anthropic.com/settings/keys
# This key is only ever read server-side (server/index.js locally,
# api/scan-receipt.js in production) — it never reaches the browser.
ANTHROPIC_API_KEY=

# Optional — port for the local scan service (server/index.js).
SCAN_PORT=8789

# Required for accounts (login/signup) and per-user purchase storage.
# Create a free project at https://supabase.com, then find these under
# Project Settings -> Data API. VITE_-prefixed vars are bundled into the
# client, which is expected here: the anon key is meant to be public and is
# safe to ship to the browser — every table it can reach is protected by
# Row Level Security policies (see supabase-schema.sql) scoped to the
# logged-in user, not by keeping this key secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required for the free-tier scan limit and the email reminder cron — this
# is the SERVICE ROLE key (Project Settings -> Data API), not the anon key.
# It bypasses Row Level Security entirely, so unlike the anon key above,
# this one must never reach the browser — only server/*.js and api/*.js
# read it, both server-only, never imported into anything Vite bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Required for email reminders (Premium only). Get a free key at
# https://resend.com/api-keys — the free tier covers this easily at
# small scale. Without a verified sending domain, leave RESEND_FROM_EMAIL
# unset to use Resend's shared test address (onboarding@resend.dev),
# which only works for testing, not real users.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional but recommended once RESEND_API_KEY is set — a random string you
# make up, also pasted into Vercel's Environment Variables. Prevents anyone
# who finds the /api/send-reminders URL from triggering it themselves
# (sending email costs money and would spam every Premium user).
CRON_SECRET=
