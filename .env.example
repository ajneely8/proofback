# Copy this file to `.env` and restart `npm run dev` after editing.

# Required for receipt scanning. Get a key at https://console.anthropic.com/
# This key is only ever read by server/index.js — it never reaches the browser.
ANTHROPIC_API_KEY=

# Optional — looks for a photo actually hosted on the store's own site
# (e.g. nike.com for a Nike purchase), so it has a real chance of being that
# retailer's actual product photo. Not a guarantee: it's whatever image best
# matches a short text description on that domain, not a literal catalog
# lookup, and a store ProofBack can't map to a domain won't be searched.
# 1. Get an API key at https://console.cloud.google.com/apis/credentials
#    (enable the "Custom Search API" on that project first)
# 2. Create a search engine at https://programmablesearchengine.google.com/
#    — set it to "Search the entire web" and turn on "Image search"
# 3. Put its Search engine ID below as GOOGLE_SEARCH_CX
# Free tier is 100 searches/day; each receipt scan uses at most one.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Optional — falls back to a representative stock photo when the store-site
# search above is unavailable or finds nothing. Still never the exact
# product photographed, since a receipt line never carries a real photo.
# Get a free key at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Optional — port for the local scan service (server/index.js).
SCAN_PORT=8789
